{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**,public/docs/**,*.docx"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/panduan.docx",
      "destination": "/api/index.js"
    },
    {
      "source": "/docs/Buku_Panduan_Pengguna_SIM-HUMAS_BPS_Kalbar.docx",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
