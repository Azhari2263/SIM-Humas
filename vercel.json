{
  "version": 2,
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**,public/docs/**,*.docx"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js?__fullpath=/download/$1"
    },
    {
      "source": "/panduan.docx",
      "destination": "/api/index.js?__fullpath=/panduan.docx"
    },
    {
      "source": "/docs/Buku_Panduan_Pengguna_SIM-HUMAS_BPS_Kalbar.docx",
      "destination": "/api/index.js?__fullpath=/docs/Buku_Panduan_Pengguna_SIM-HUMAS_BPS_Kalbar.docx"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

